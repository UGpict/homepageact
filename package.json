{
  "name": "sitebot",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/web"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./application": "./src/application/index.ts"
  },
  "scripts": {
    "test": "node --import tsx --test test/phase0.test.ts test/phase1.test.ts test/application.test.ts test/seo.test.ts",
    "typecheck": "tsc --noEmit && npm run typecheck -w apps/web",
    "sitebot": "tsx src/cli.ts",
    "dev": "npm run dev -w apps/web",
    "build:web": "npm run build -w apps/web"
  },
  "dependencies": {
    "sharp": "^0.35.5",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
